{
  "nombre": "tanda-3",
  "descripcion": "Los tres demos por repositorio y por URL, con y sin el documento de requisitos, con los parámetros de la estimación de cada ficha.",
  "proyecto": "demo",
  "agente": "qa-agent-v2",
  "max_simultaneas": 2,
  "intervalo_segundos": 120,
  "reintentos": 2,
  "motivos_de_infra": [
    "provision_error",
    "interrupted"
  ],
  "cloud_run": {
    "proyecto": "fit-qa-495414",
    "region": "us-central1",
    "salud": "https://{servicio}-o6q2dj7niq-uc.a.run.app/health"
  },
  "verdad": {
    "01": "01-biblioteca/verdad.json",
    "02": "02-canchas/verdad.json",
    "03": "03-backoffice/verdad.json"
  },
  "perfiles": {
    "01": {
      "min_test_cases": 20,
      "max_test_cases": 20,
      "max_iterations": 6,
      "env": {
        "FIT_MAX_TURNS_ANALYZER": "60"
      },
      "plan_gate": true
    },
    "02": {
      "min_test_cases": 45,
      "max_test_cases": 68,
      "max_iterations": 16,
      "env": {
        "FIT_MAX_TURNS_ANALYZER": "90"
      },
      "plan_gate": false
    },
    "03": {
      "min_test_cases": 71,
      "max_test_cases": 107,
      "max_iterations": 24,
      "env": {
        "FIT_MAX_TURNS_ANALYZER": "120"
      },
      "plan_gate": true
    }
  },
  "ejecuciones": [
    {
      "id": "03-api",
      "demo": "03",
      "modo": "url sin requisitos",
      "target": "demo-03-api",
      "perfil": "03",
      "grupo": "03",
      "cloud_run": [
        "fitqa-demo-03-api"
      ],
      "dataset": "tandas/datos/03-backoffice.json",
      "minutos_estimados": 150
    },
    {
      "id": "03-api-req",
      "demo": "03",
      "modo": "url con requisitos",
      "target": "demo-03-api",
      "perfil": "03",
      "grupo": "03",
      "cloud_run": [
        "fitqa-demo-03-api"
      ],
      "dataset": "tandas/datos/03-backoffice.json",
      "documentos": [
        "03-backoffice/requisitos-y-criterios-de-aceptacion.md"
      ],
      "minutos_estimados": 150
    },
    {
      "id": "03-web",
      "demo": "03",
      "modo": "url sin requisitos",
      "target": "demo-03-web",
      "perfil": "03",
      "grupo": "03",
      "cloud_run": [
        "fitqa-demo-03-api",
        "fitqa-demo-03-web"
      ],
      "dataset": "tandas/datos/03-backoffice.json",
      "network_allowlist": [
        "fitqa-demo-03-api-o6q2dj7niq-uc.a.run.app"
